{
  "cSpell.allowCompoundWords": true,
  "cSpell.ignorePaths": ["package.json", "package-lock.json", "node_modules", "vscode-extension", ".git/objects", ".vscode", ".vscode-insiders"],
  "cSpell.ignoreRegExpList": ["/[\\u0E00-\\u0E7F]/g"],
  "cSpell.language": "en",
  "cSpell.words": ["Agoda", "ALLINCOUNTRY", "clsx", "dexters", "Favourite", "firstname", "Gother", "Gothers", "isgroup", "KBANK", "klub", "KLUBEXCLUSIVE", "Lococalstorage", "Lqip", "phonenumber", "rgba", "rsvn", "showtourist", "signin", "SPECIALDEAL", "swiper", "tailwindcss", "TIKTOK", "vasup", "waittobook", "waittopay", "webp"],
  "compile-hero.disable-compile-files-on-did-save-code": false,
  "editor.codeActionsOnSave": {
    "source.addMissingImports": "explicit",
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "explicit"
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.detectIndentation": false,
  "editor.formatOnSave": true,
  "editor.quickSuggestions": { "strings": true },
  "editor.tabSize": 2,
  "eslint.enable": true,
  "eslint.probe": ["astro", "javascript", "javascriptreact", "typescript", "typescriptreact", "html", "mdx", "vue", "markdown", "json", "jsonc"],
  "eslint.rules.customizations": [{ "rule": "*", "severity": "warn" }],
  "i18n-ally.annotations": false,
  "i18n-ally.defaultNamespace": "translation",
  "i18n-ally.displayLanguage": "th-th",
  "i18n-ally.keystyle": "nested",
  "i18n-ally.localesPaths": ["src/app/i18n/locales"],
  "i18n-ally.namespace": true,
  "i18n-ally.sortKeys": true,
  "i18n-ally.sourceLanguage": "en-us",
  "jest.enable": false,
  "jest.outputConfig": "test-results-based",
  "jest.runMode": { "coverage": true, "runAllTestsOnStartup": false, "type": "watch" },
  "prettier.ignorePath": ".gitignore",
  "search.exclude": { "package-lock.json": true },
  "tailwindCSS.classFunctions": ["cva", "cx"],
  "tailwindCSS.classAttributes": ["class", "className", "classNames", "ngClass", ".***Styles", ".*****Style"],
  "tailwindCSS.experimental.classRegex": [
    ["Style = '([^']*)'", "Style\\s*=\\s*['\"`]([^'\"`]*)['\"`]"],
    ["Class = '([^']*)'", "Class\\s*=\\s*['\"`]([^'\"`]*)['\"`]"],
    ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
    ["extendVariants\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
    ["cx\\(([^)]*)\\)", "(?:'|\"|`)([^']*)(?:'|\"|`)"],
    ["cn\\(([^)]*)\\)", "(?:'|\"|`)([^']*)(?:'|\"|`)" ]
  ],
  "tailwindCSS.includeLanguages": { "html": "html", "javascript": "javascript", "javascriptreact": "javascriptreact", "typescript": "typescript", "typescriptreact": "typescriptreact" },
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "typescript.tsdk": "node_modules/typescript/lib",
  "[snippets]": { "editor.defaultFormatter": "vscode.json-language-features" },
  "[json]": { "editor.defaultFormatter": "vscode.json-language-features" },
  "[javascript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[javascriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[typescript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[typescriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[scss]": { "editor.defaultFormatter": "vscode.css-language-features" }
}
